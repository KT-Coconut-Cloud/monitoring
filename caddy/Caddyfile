{
	admin off
}

# 외부에 열리는 유일한 입구 (443).
#  - 온프렘 Alloy → Prometheus / Loki : basic auth 필수, 지정된 두 경로만 허용
#  - 그 외 → Grafana (Grafana 자체 로그인)
https://:443 {
	tls /certs/server.crt /certs/server.key

	handle /healthz {
		respond "ok" 200
	}

	handle /api/v1/write {
		basic_auth {
			{$INGEST_USER} {$INGEST_PASS_HASH}
		}
		reverse_proxy prometheus:9090
	}

	handle /loki/api/v1/push {
		basic_auth {
			{$INGEST_USER} {$INGEST_PASS_HASH}
		}
		reverse_proxy loki:3100
	}

	handle {
		reverse_proxy grafana:3000
	}
}

{$GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
}
