// Alloy — DB VM (Primary / Replica 각각), systemd 서비스로 실행
// 역할: 이 VM 의 MySQL / 호스트 메트릭과 MySQL 에러 로그를 KT Cloud 로 "밖으로만" 보낸다.
// /etc/sysconfig/alloy 에 넣을 env:
//   KT_PROM_URL, KT_LOKI_URL, KT_USER, KT_PASS, KT_CA_FILE
//   DB_ROLE         (primary | replica)
//   MYSQL_DSN       (alloy_mon:<pw>@(127.0.0.1:3306)/)
//   MYSQL_ERROR_LOG (예: /var/log/mysqld.log)

logging {
	level  = "info"
	format = "logfmt"
}

// ───────────────── 전송 ─────────────────

prometheus.remote_write "kt" {
	endpoint {
		url = sys.env("KT_PROM_URL")

		basic_auth {
			username = sys.env("KT_USER")
			password = sys.env("KT_PASS")
		}

		tls_config {
			ca_file = sys.env("KT_CA_FILE")
		}
	}

	external_labels = {
		cluster = "onprem-db",
		role    = sys.env("DB_ROLE"),
		host    = constants.hostname,
	}
}

loki.write "kt" {
	endpoint {
		url = sys.env("KT_LOKI_URL")

		basic_auth {
			username = sys.env("KT_USER")
			password = sys.env("KT_PASS")
		}

		tls_config {
			ca_file = sys.env("KT_CA_FILE")
		}
	}

	external_labels = {
		cluster = "onprem-db",
		role    = sys.env("DB_ROLE"),
		host    = constants.hostname,
	}
}

// ───────────────── 메트릭 ─────────────────

prometheus.exporter.mysql "db" {
	data_source_name = sys.env("MYSQL_DSN")
}

prometheus.scrape "mysql" {
	job_name        = "mysql"
	targets         = prometheus.exporter.mysql.db.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.kt.receiver]
}

prometheus.exporter.unix "host" { }

prometheus.scrape "node" {
	job_name        = "node-exporter"
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.kt.receiver]
}

// ───────────────── 로그 ─────────────────
// 에러 로그만 수집한다. slow query log / general log 는 쿼리 값(PII)이 들어갈 수 있어 수집하지 않는다.

loki.source.file "mysql_error" {
	targets = [{
		__path__ = sys.env("MYSQL_ERROR_LOG"),
		job      = "mysql-error",
	}]
	forward_to = [loki.process.mask.receiver]
}

loki.process "mask" {
	stage.replace {
		expression = "(\\d{6}[- ]?[1-4]\\d{6})"
		replace    = "[RRN]"
	}

	stage.replace {
		expression = "(01[016789][- ]?\\d{3,4}[- ]?\\d{4})"
		replace    = "[PHONE]"
	}

	stage.replace {
		expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
		replace    = "[EMAIL]"
	}

	forward_to = [loki.write.kt.receiver]
}
