# cp .env.example .env 후 값 채우기 (.env 는 Git에 올리지 말 것)

# KT Cloud 공인 IP (Grafana 주소와 인증서 SAN에 사용)
PUBLIC_IP=

# Grafana admin 비밀번호
GRAFANA_ADMIN_PASSWORD=

# 온프렘 Alloy가 쓰는 수신 계정 (Prometheus/Loki 입구 basic auth)
INGEST_USER=alloy
# bcrypt 해시. 반드시 작은따옴표로 감쌀 것 ($ 문자 때문)
#   docker run --rm caddy:2 caddy hash-password --plaintext '<비밀번호>'
INGEST_PASS_HASH='$2a$14$REPLACE_ME'

# 보관 기간 (디스크 용량에 맞게 조정)
PROM_RETENTION=15d
PROM_RETENTION_SIZE=10GB

# Grafana 공개 도메인 (Caddy가 Let's Encrypt 인증서를 자동 발급)
GRAFANA_DOMAIN=grafana.example.com
