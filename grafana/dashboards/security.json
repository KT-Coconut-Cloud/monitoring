    {
      "type": "stat",
      "title": "보안 채널 알림 (발화 중)",
      "description": "channel=security 라벨이 붙은 알림만 센다 (Discord #security로 전송)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\",channel=\"security\"}) or vector(0)",
