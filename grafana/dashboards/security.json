      "panels": []
    },
    {
      "type": "stat",
      "title": "마스킹 누락 의심 (최근 1시간)",
      "description": "주민번호 형태가 마스킹 후에도 남아 있는 로그 수. 0이어야 한다. 숫자 ID·타임스탬프가 오탐될 수 있어 값이 나오면 해당 로그를 직접 확인한다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=~\"onprem-.*\"} |~ \"\\\\d{6}[- ]?[1-4]\\\\d{6}\" [1h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "마스킹 치환 건수",
      "description": "[RRN]·[PHONE]·[EMAIL]로 바뀐 로그 수. 0이 아니면 원본에 패턴이 있었고 마스킹이 동작했다는 뜻.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (cluster) (count_over_time({cluster=~\"onprem-.*\"} |~ \"\\\\[(RRN|PHONE|EMAIL)\\\\]\" [$__interval]))",
          "legendFormat": "{{cluster}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
