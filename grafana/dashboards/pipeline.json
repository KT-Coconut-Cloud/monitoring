      "type": "logs",
      "title": "최근 단계 이벤트",
      "description": "run_id를 위쪽 변수에 입력하면 한 배치만 볼 수 있다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"onprem-k3s\",namespace=\"pii-job\"} | json | __error__=\"\" | run_id=~\"$run_id\"",
          "legendFormat": "",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
