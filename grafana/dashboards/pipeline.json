{
  "uid": "coconut-pipeline",
  "title": "2. 파이프라인 현황",
  "description": "pii-job 단계 이벤트(run_id, stage, status, count)와 Argo Workflows 실행 상태. 개인정보 원본은 이 화면에 나오지 않는다.",
  "tags": [
    "coconut",
    "pipeline"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "run_id",
        "label": "run_id (정규식)",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "coconut"
      ],
      "asDropdown": true,
      "title": "코코넛 대시보드",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "워크플로 상태 (Argo Workflows, pii-job)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "성공한 워크플로",
      "description": "Argo Workflows 컨트롤러 지표(argo_workflows_gauge, phase=Succeeded). 지금 클러스터에 남아 있는 성공 워크플로 수라서, 워크플로가 삭제(TTL/GC)되면 숫자도 줄어든다. Argo 3.6 부터 지표 이름이 argo_workflows_count 에서 argo_workflows_gauge 로 바뀌었다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(argo_workflows_gauge{cluster=\"onprem-k3s\",phase=\"Succeeded\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "실패한 워크플로",
      "description": "Argo Workflows 컨트롤러 지표(argo_workflows_gauge). PipelineWorkflowFailed 알림과 같은 조건. 워크플로가 삭제(GC)되면 숫자도 사라진다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(argo_workflows_gauge{cluster=\"onprem-k3s\",phase=\"Failed\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "실행 중 워크플로",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(argo_workflows_gauge{cluster=\"onprem-k3s\",phase=\"Running\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
